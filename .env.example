# ==============================================================================
# Astra AI 2026 — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend or running local services.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI ORCHESTRATION & REASONING (REQUIRED)
# ------------------------------------------------------------------------------
# Google Gemini API Key used by the Agentic Planner and Report Synthesizer.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model selection (default: gemini-2.0-flash)
# Supported: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=0.1
# GEMINI_MAX_OUTPUT_TOKENS=4096

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND SERVER SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Host interface and network port for the FastAPI service
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# Optional API authentication key for client requests (Leave blank for open local dev)
# API_KEY=

# CORS Allowed Origins (comma-separated list of origins)
# ALLOWED_ORIGINS=https://sih-orbilens-2026-tm.web.app,http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 3. FILE UPLOADS & RUNTIME DIRECTORIES (OPTIONAL)
# ------------------------------------------------------------------------------
# Maximum upload file size in Megabytes (default: 200)
# MAX_FILE_SIZE_MB=200
# MAX_FILES_PER_REQUEST=2
# UPLOAD_DIR=./uploads
# OUTPUT_DIR=./outputs

# ------------------------------------------------------------------------------
# 4. HARDWARE ACCELERATION & MODEL WEIGHTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Directory where local specialist weights and adapters are stored
# MODEL_CACHE_DIR=./models
# BEN_CLASSIFIER_PATH=./models/ben_classifier.pth

# Enable INT4/INT8 quantization for 8GB/12GB/16GB consumer GPUs (RTX 30/40/50 series)
# USE_INT4_QUANTIZATION=true
# MAX_VRAM_GB=10.0

# ------------------------------------------------------------------------------
# 5. PIPELINE EXECUTION & RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
# MAX_PLAN_STEPS=5
# STEP_TIMEOUT_SECONDS=90
# MAX_RETRIES_PER_STEP=1
# RATE_LIMIT_REQUESTS_PER_MINUTE=6

# ------------------------------------------------------------------------------
# 6. TRAINING & EXPERIMENT TRACKING (OPTIONAL - TRAINING SUBSYSTEM ONLY)
# ------------------------------------------------------------------------------
# Weights & Biases API Key for logging fine-tuning runs
# WANDB_API_KEY=your_wandb_api_key_here
# CUDA_VISIBLE_DEVICES=0
