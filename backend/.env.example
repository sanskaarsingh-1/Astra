# ==============================================================================
# Astra AI Backend — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the FastAPI backend.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AI ORCHESTRATION & REASONING (REQUIRED)
# ------------------------------------------------------------------------------
# Google Gemini API Key used by the Agentic Planner and Report Synthesizer.
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model selection (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=0.1
# GEMINI_MAX_OUTPUT_TOKENS=4096

# ------------------------------------------------------------------------------
# 2. FASTAPI BACKEND SERVER SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# Optional API key for header authentication (X-API-Key). Leave blank for open dev.
# API_KEY=

# CORS Allowed Origins (comma-separated list)
# ALLOWED_ORIGINS=https://sih-orbilens-2026-tm.web.app,http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 3. FILE STORAGE & MODEL INFERENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# MAX_FILE_SIZE_MB=200
# MAX_FILES_PER_REQUEST=2
# UPLOAD_DIR=./uploads
# OUTPUT_DIR=./outputs
# MODEL_CACHE_DIR=./models
# BEN_CLASSIFIER_PATH=./models/ben_classifier.pth
# USE_INT4_QUANTIZATION=true
# MAX_VRAM_GB=10.0

# ------------------------------------------------------------------------------
# 4. PIPELINE EXECUTION & RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
# MAX_PLAN_STEPS=5
# STEP_TIMEOUT_SECONDS=90
# MAX_RETRIES_PER_STEP=1
# RATE_LIMIT_REQUESTS_PER_MINUTE=6
